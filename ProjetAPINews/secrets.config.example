<?xml version="1.0" encoding="utf-8"?>
<!-- Copy this file to secrets.config and put your own values. secrets.config is ignored by Git. -->
<!-- Free NewsAPI key: https://newsapi.org/register -->
<appSettings>
  <add key="NewsApiKey" value="YOUR_NEWSAPI_KEY" />
  <add key="MySqlConnection" value="server=localhost;port=3306;database=newsapi;uid=root;pwd=YOUR_PASSWORD;" />
</appSettings>
