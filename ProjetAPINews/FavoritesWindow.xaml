<Window x:Class="Api_call.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Api_call"
        mc:Ignorable="d"
        Title="NewsAPI — Mes favoris" Height="450" Width="800">
    <Grid>
        <ListBox ItemsSource="{Binding Favorites}" DisplayMemberPath="Title" MouseDoubleClick="FavoritesList_MouseDoubleClick"/>
    </Grid>
</Window>
