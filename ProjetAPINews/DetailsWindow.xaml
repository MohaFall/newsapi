<Window x:Class="Api_call.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Api_call"
        mc:Ignorable="d"
        Title="NewsAPI — Détails de l'article" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Image et titre -->
        <StackPanel Orientation="Horizontal" Margin="10">
            <Image Source="{Binding UrlToImage}" Width="100" Height="100" Stretch="UniformToFill" />
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Description -->
        <ScrollViewer Grid.Row="1" Margin="10">
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
        </ScrollViewer>

        <!-- Bouton Ajouter aux favoris -->
        <Button x:Name="FavoriteButton" Grid.Row="2" HorizontalAlignment="Right" Margin="10" Click="ToggleFavorite_Click" />
    </Grid>
</Window>
